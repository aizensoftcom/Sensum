{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sensum:event:v0.1",
  "title": "Sensum Event Protocol v0.1",
  "type": "object",
  "required": ["id", "occurred_at", "kind", "source", "modality", "summary", "confidence", "novelty", "urgency"],
  "properties": {
    "id": {"type": "string"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "kind": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "modality": {"enum": ["vision", "audio", "screen", "browser", "file", "api", "sensor", "custom"]},
    "summary": {"type": "string"},
    "entity": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "novelty": {"type": "number", "minimum": 0, "maximum": 1},
    "urgency": {"type": "number", "minimum": 0, "maximum": 1},
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {"path": {"type": "string"}, "before": {}, "after": {}},
        "additionalProperties": false
      }
    },
    "metadata": {"type": "object"},
    "tags": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
